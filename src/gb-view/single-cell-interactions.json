    {
      "id": "default",
      "label": "By Interaction Type",
      "columns": [
        {
          "field": "title",
          "label": "Title",
          "width": 320
        },
        {
          "field": "interactionType",
          "label": "Interaction Type",
          "width": 220
        },
        {
          "field": "cellType",
          "label": "Cell Type",
          "width": 260
        }
      ],
      "grouping": ["interactionType"],
      "leaf": "title"
    }
  ],
